#
# bimIPs PROTOCOL SIGNAL CONFIGURATION GUIDE
# Version: 2026.02.04-Stable
# Author:  Paul Aigbokhai Olukayode
# ==============================================================================
# This environment file defines the operational constraints of the Bimips server.
# Modifying these values requires a full service restart to apply changes.
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION 1: NETWORK & LISTENER SETTINGS
# ------------------------------------------------------------------------------
# The internal router resource path (WebSocket endpoint).
BIMIP_RESOURCE_PATH=/

# Port for standard unencrypted (TCP/WS) traffic.
BIMIP_NONE_TLS_PORT=4000

# Port for encrypted (TLS/WSS) traffic.
BIMIP_PORT_TLS=4001

# Global idle timeout (ms) before closing inactive connections.
BIMIP_NETWORK_IDLE_TIMEOUT_MS=60000


# ------------------------------------------------------------------------------
# SECTION 2: SECURITY & CRYPTOGRAPHY (TLS/JWT)
# ------------------------------------------------------------------------------
# Toggle TLS/SSL encryption for all inbound traffic.
BIMIP_SECURE_TLS=false

# Paths to SSL assets (Relative to application root or absolute).
BIMIP_SSL_CERT_PATH="./priv/cert/selfsigned.pem"
BIMIP_SSL_KEY_PATH="./priv/cert/selfsigned_key.pem"

# JWT Authentication settings for stanza verification.
BIMIP_JWT_PUBLIC_KEY_PATH="priv/keys/public.pem"
BIMIP_JWT_ALGORITHM="RS256"


# ------------------------------------------------------------------------------
# SECTION 3: QUEUE ENGINE & PERFORMANCE TUNING
# ------------------------------------------------------------------------------
# # Number of logical shards for the message queue (Recommended: CPU Cores / 4).
# BIMIP_QUEUE_NUM_SHARDS=16

# Max messages pulled per batch for ingestion cycles.
BIMIP_QUEUE_MAX_BATCH_SIZE=100

# Max records held in RAM per shard before forcing disk commit.
BIMIP_QUEUE_MAX_BUFFER_PER_SHARD=10000000

# High-water mark for stable record processing.
BIMIP_QUEUE_STABLE_LIMIT=1000


# ------------------------------------------------------------------------------
# SECTION 4: STORAGE, SEGMENTATION & ARCHIVAL
# ------------------------------------------------------------------------------
# Storage root for compacted log segments.
BIMIP_STORAGE_ARCHIVE_ROOT="data/archive"

# Max messages per segment file. MUST be a multiple of 1000 (Internal Stride).
BIMIP_STORAGE_MAX_SEGMENT_MESSAGES=1000000
# Sparse index of max segment message 100000/1000 = 100 sparse index in a log
BIMIP_STORAGE_STRIDE=1000

# Concurrency limit for open file descriptors during read operations.
BIMIP_STORAGE_MAX_READ_FDS=11

# Cycle interval (hours) for log compaction and rotation.
BIMIP_STORAGE_COMPACT_INTERVAL_HOURS=4


# ------------------------------------------------------------------------------
# SECTION 5: DURABILITY & DATA LIFECYCLE
# ------------------------------------------------------------------------------
# Time (seconds) to force buffer flush to disk (RAM to Write-Ahead Log).
BIMIP_FLUSH_INTERVAL_SECONDS=10

# Total lifespan of a message on disk before permanent deletion.
BIMIP_LIFECYCLE_RETENTION_DAYS=1

# Time To Live (minutes) for active session state.
BIMIP_LIFECYCLE_DEFAULT_TTL_MIN=120

# Rotation grace period (minutes) before marking data as "stale".
BIMIP_LIFECYCLE_ROTATION_OFFSET_MIN=60


# ------------------------------------------------------------------------------
# SECTION 6: ADAPTIVE HEARTBEAT & MONITORING
# ------------------------------------------------------------------------------

# Internal federation reporting interval.
BIMIP_HEARTBEAT_REPORT_MS=60000

# Inactivity threshold before session termination and manifest cleanup.
BIMIP_HEARTBEAT_DEVICE_STALE_SEC=600

# Threshold of total packet silence before a forced probe is triggered.
BIMIP_HEARTBEAT_MAX_SILENCE_MS=5000


# ------------------------------------------------------------------------------
# SECTION 7: PROTOCOL VALIDATION & ANTI-REPLAY
# ------------------------------------------------------------------------------
# Max age (ms) for a Ping timestamp to be considered valid. 
# Prevents replay attacks. (Recommended: 30000 - 60000).
BIMIP_VALIDATOR_REPLAY_WINDOW_MS=30000

# Tolerance (ms) for pings with timestamps slightly in the future.
# Accounts for minor clock drift between client and server.
BIMIP_VALIDATOR_CLOCK_FUTURE_TOLERANCE_MS=10000

# ------------------------------------------------------------------------------
# SECTION 8: MULTI DEVICES
# ------------------------------------------------------------------------------
# Max idle time for a device in seconds 
BIMIP_DEVICE_STALE_THRESHOLD_SECONDS=600


# ------------------------------------------------------------------------------
# SECTION 9: PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
# APNS operation mode: 'dev' for Sandbox/Development, 'prod' for Production.
BIMIP_APNS_MODE=dev

# --- OPTION A: CERTIFICATE BASED (PEM) ---
# Paths to Apple Push Notification certificates (Relative to app root).
BIMIP_APNS_CERT_PATH=priv/cert/apns_cert.pem
BIMIP_APNS_KEY_PATH=priv/cert/apns_key.pem

# --- OPTION B: TOKEN BASED (P8) ---
# Uncomment and fill these if using Apple Auth Keys instead of Certificates.
# BIMIP_APNS_KEY_ID=ABC123DEFG
# BIMIP_APNS_TEAM_ID=DEF456GHIJ
# BIMIP_APNS_P8_PATH=priv/cert/AuthKey_ABC123DEFG.p8

# --- GOOGLE FIREBASE (ANDROID) ---
# Path to Google Firebase Service Account JSON for FCM v1 API.
BIMIP_FCM_SERVICE_ACCOUNT_PATH=priv/fcm/service_account.json


# ==============================================================================
# END OF CONFIGURATION - Generated by bimIPs CLI
# ==============================================================================