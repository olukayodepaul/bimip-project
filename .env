# ---------- TLS / Non-TLS ----------
BIMIP_SECURE_TLS=false

BIMIP_CLEAR_PORT=4000
BIMIP_CERT_FILE=/app/priv/keys/cert.pem
BIMIP_KEY_FILE=/app/priv/keys/key.pem
BIMIP_RESOURCE_PATH=/
BIMIP_IDLE_TIMEOUT=60000

# ---------- JWT ----------
BIMIP_PUBLIC_KEY=/app/priv/keys/public.pem
BIMIP_SIGNING_ALGORITHM=RS256

# ---------- Adaptive Network Ping/Pong ----------
BIMIP_DEFAULT_PING_INTERVAL_MS=10000
BIMIP_MAX_ALLOWED_DELAY_SECONDS=120
BIMIP_MAX_PONG_RETRIES=5
BIMIP_INITIAL_MAX_MISSED_PINGS=6

# ---------- Device & Server State ----------
BIMIP_DEVICE_STALE_THRESHOLD_SECONDS=600
BIMIP_DEVICE_FORCE_CHANGE_SECONDS=300
BIMIP_SERVER_STALE_THRESHOLD_SECONDS=600
BIMIP_SERVER_FORCE_CHANGE_SECONDS=120

# ---------- Queue ----------
BIMIP_MAX_QUEUE_SIZE=1000

# ---------- Sharding ----------
BIMIP_NUM_SHARDS=16
