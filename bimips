#!/bin/sh
# -------------------------------------------------------------------
# Bimips CLI - Comprehensive (Domain Aware: wsone.com)
# -------------------------------------------------------------------

# Get absolute path to the directory containing this script
DIR="$(cd "$(dirname "$0")" && pwd)"
RELEASE_BIN="$DIR/rel/bimips/bin/bimips"
ENV_FILE="$DIR/.env"

# 1. Internal Permission Check (Self-Healing)
if [ -f "$RELEASE_BIN" ] && [ ! -x "$RELEASE_BIN" ]; then
  chmod +x "$RELEASE_BIN"
fi

# 2. Load environment variables quietly
if [ -f "$ENV_FILE" ]; then
  set -a
  . "$ENV_FILE"
  set +a
fi

# 3. Check for the existence of the release binary
if [ ! -f "$RELEASE_BIN" ]; then
  echo "[ERROR] Release binary not found at: $RELEASE_BIN"
  exit 1
fi

# 4. Networking Configuration for wsone.com
NODE_NAME="${RELEASE_NODE:-bimips@127.0.0.1}"
COOKIE="${RELEASE_COOKIE:-bimips_cookie}"
OPTS="--name $NODE_NAME --cookie $COOKIE"

COMMAND="$1"
shift 

case "$COMMAND" in
  start)
    if "$RELEASE_BIN" pid >/dev/null 2>&1; then
      echo "[INFO] Bimips is already running."
      exit 0
    fi

    echo "[INFO] Starting Bimips as Long Name: $NODE_NAME..."
    # Background start with your verification loop
    "$RELEASE_BIN" start $OPTS >/dev/null 2>&1 &

    MAX_RETRIES=5
    COUNT=0
    while [ $COUNT -lt $MAX_RETRIES ]; do
      PID=$("$RELEASE_BIN" pid 2>/dev/null)
      if [ -n "$PID" ]; then
        echo "[INFO] Bimips started successfully (PID: $PID)"
        exit 0
      fi
      sleep 1
      COUNT=$((COUNT + 1))
    done

    echo "[ERROR] Bimips failed to start."
    echo "[HINT] Check logs at $DIR/rel/bimips/log/erlang.log.1"
    exit 1
    ;;

  live)
    echo "[INFO] Starting system in LIVE mode (foreground logs)..."
    # Runs start_iex internally so you can see errors immediately
    exec "$RELEASE_BIN" start_iex $OPTS
    ;;

  daemon)
    echo "[INFO] Starting system as a daemon..."
    exec "$RELEASE_BIN" daemon $OPTS
    ;;

  service)
    echo "[INFO] Starting Bimips as a background service with IEx..."
    # Runs daemon_iex internally
    exec "$RELEASE_BIN" daemon_iex $OPTS
    ;;

  stop)
    PID=$("$RELEASE_BIN" pid 2>/dev/null)
    if [ -z "$PID" ]; then
      echo "[INFO] Bimips is not running."
      exit 0
    fi
    echo "[INFO] Stopping Bimips (PID: $PID)..."
    "$RELEASE_BIN" stop >/dev/null 2>&1
    
    for i in $(seq 1 10); do
      if ! ps -p "$PID" >/dev/null 2>&1; then
        echo "[INFO] Bimips stopped successfully."
        exit 0
      fi
      sleep 1
    done
    echo "[ERROR] Bimips did not stop within expected time."
    exit 1
    ;;

  restart)
    "$0" stop
    sleep 2
    "$0" start
    ;;

  status)
    PID=$("$RELEASE_BIN" pid 2>/dev/null)
    if [ -n "$PID" ] && ps -p "$PID" >/dev/null 2>&1; then
      echo "[INFO] Bimips is running (PID: $PID)"
      exit 0
    else
      echo "[INFO] Bimips is stopped"
      exit 1
    fi
    ;;

  pid)
    "$RELEASE_BIN" pid
    ;;

  version)
    "$RELEASE_BIN" version
    ;;

  remote|console)
    echo "[INFO] Attaching to $NODE_NAME..."
    exec "$RELEASE_BIN" remote $OPTS
    ;;

  eval|rpc)
    if [ $# -eq 0 ]; then
      echo "[ERROR] Missing expression for $COMMAND"
      exit 1
    fi
    exec "$RELEASE_BIN" "$COMMAND" "$@"
    ;;

  *)
    echo "Usage: ./bimips {start|live|daemon|service|stop|restart|status|pid|version|remote|eval|rpc}"
    exit 1
    ;;
esac